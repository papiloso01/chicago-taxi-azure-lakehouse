{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 77,
  "maxItems": 77,
  "items": {
    "type": "object",
    "required": [
      "area_num_1",
      "community",
      "the_geom"
    ],
    "properties": {
      "area_num_1": {
        "type": "string",
        "pattern": "^[1-9][0-9]?$"
      },
      "community": {
        "type": "string",
        "minLength": 1
      },
      "the_geom": {
        "type": "object",
        "required": [
          "type",
          "coordinates"
        ],
        "properties": {
          "type": {
            "enum": [
              "Polygon",
              "MultiPolygon"
            ]
          },
          "coordinates": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "additionalProperties": true
  }
}
