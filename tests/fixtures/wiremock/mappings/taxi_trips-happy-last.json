{
  "request": {
    "method": "GET",
    "urlPath": "/fixtures/taxi_trips/happy",
    "queryParameters": {
      "$where": {
        "contains": "trip_id > 'b'"
      },
      "$limit": {
        "equalTo": "2"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "taxi_trips/last.json"
  }
}
