{
  "request": {
    "method": "GET",
    "urlPath": "/fixtures/taxi_trips/happy",
    "queryParameters": {
      "$limit": {
        "equalTo": "2"
      },
      "$order": {
        "equalTo": "trip_id ASC"
      },
      "$where": {
        "doesNotMatch": ".*trip_id >.*"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "taxi_trips/first.json"
  }
}
